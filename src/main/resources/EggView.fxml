<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.cfogrady.dim.modifier.controllers.EggViewController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <VBox alignment="CENTER" spacing="8.0">
         <children>
            <Label text="Digi-Egg Sprite (Expected: 32x40)" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
            <Label fx:id="eggIndexLabel" text="Egg 1 of 1" style="-fx-font-size: 12px;" />
            <StackPane fx:id="eggSpriteContainer" minWidth="64" minHeight="80" style="-fx-border-color: gray; -fx-border-width: 1; -fx-background-color: black;">
               <children>
                  <ImageView fx:id="eggSpritesView" fitHeight="80.0" fitWidth="64.0" pickOnBounds="true" preserveRatio="true"/>
               </children>
            </StackPane>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="prevEggButton" mnemonicParsing="false" text="Prev Egg" />
                  <Button fx:id="nextEggButton" mnemonicParsing="false" text="Next Egg" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
