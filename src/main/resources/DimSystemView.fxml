<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="10.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.cfogrady.dim.modifier.controllers.DimSystemViewController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <VBox alignment="TOP_CENTER" spacing="5.0">
         <children>
            <Label text="Background (80x160)" style="-fx-font-weight: bold;" />
            <StackPane fx:id="backgroundSpriteContainer" minWidth="160" minHeight="80">
               <children>
                  <ImageView fx:id="backgroundsView" fitHeight="160.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true"/>
               </children>
            </StackPane>
         </children>
      </VBox>
      <VBox spacing="10.0">
         <children>
            <VBox alignment="TOP_CENTER" spacing="5.0">
               <children>
                  <Label text="Icon (42x42)" style="-fx-font-weight: bold;" />
                  <StackPane style="-fx-background-color: black;" fx:id="iconSpriteContainer" minWidth="42" minHeight="42">
                     <children>
                        <ImageView fx:id="iconSpriteView" pickOnBounds="true" preserveRatio="true"/>
                     </children>
                  </StackPane>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>
