<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.github.cfogrady.dim.modifier.controls.ImageIntListView?>
<?import javafx.scene.layout.AnchorPane?>

<VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.cfogrady.dim.modifier.controllers.CharacterViewController" VBox.vgrow="ALWAYS">
   <children>
      <HBox spacing="10.0" VBox.vgrow="ALWAYS">
         <!-- Left character selection list (Fixed minWidth so it always renders even if window is small) -->
         <VBox alignment="CENTER_LEFT" spacing="10.0" minWidth="140.0" prefWidth="140.0">
            <ImageIntListView fx:id="characterSelectionListView" minWidth="140.0" prefWidth="140.0" VBox.vgrow="ALWAYS" />
         </VBox>

         <!-- Right content area wrapped in ScrollPane so resizing small window doesn't compress or hide sidebar -->
         <ScrollPane fitToHeight="true" fitToWidth="true" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
               <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                           <children>
                              <StackPane fx:id="nameBox" maxHeight="25.0" prefWidth="80.0" style="-fx-background-color: black;" />
                              <Label text="Name (80x15)" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: black;" />
                           </children>
                        </VBox>
                        <Button fx:id="newCharacterButton" text="Add Character"/>
                        <Button fx:id="deleteCharacterButton" text="Delete Character"/>
                        <Button fx:id="moveUpCharacterButton" text="Move Up"/>
                        <Button fx:id="moveDownCharacterButton" text="Move Down"/>
                        <Button fx:id="exportCharacterSpritesButton" text="Export Sprite Sheet"/>
                        <Button fx:id="importCharacterSpritesButton" text="Import Sprite Sheet"/>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </HBox>
                  <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
                     </padding>
                     <children>
                        <VBox spacing="5.0">
                           <children>
                              <Label text="Stats" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: black;" />
                              <AnchorPane fx:id="statsSubViewContainer" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Transformations" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: black;" />
                              <AnchorPane fx:id="transformationsSubViewContainer" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </VBox>
            </content>
         </ScrollPane>
      </HBox>
   </children>
</VBox>
